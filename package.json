{
  "name": "epices-masala",
  "version": "1.0.0",
  "private": true,
  "description": "MASALA by épices — synthé wavetable bass music : appli téléphone + plugin VST3/AU + compte de synchro",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "start": "node server/server.mjs",
    "test": "node tests/render.mjs && node tests/parity.mjs",
    "build:web": "node tools/build-web.mjs",
    "ios:sync": "node tools/build-web.mjs && npx cap sync ios",
    "ios:open": "npx cap open ios"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@capacitor/share": "8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@fontsource/bricolage-grotesque": "5.3.0"
  }
}
